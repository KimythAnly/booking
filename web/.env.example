# Google OAuth Client ID (create in Google Cloud Console > Credentials > OAuth Client ID > Web application)
VITE_GOOGLE_CLIENT_ID=

# Deployed Google Apps Script Web App URL (the /exec endpoint)
VITE_APPS_SCRIPT_URL=

# Local testing only: set to "true" to run against an in-browser mock (no backend needed)
VITE_USE_MOCK=false
